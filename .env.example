# ==============================================================================
# Gen'X Vision School System — Environment Configuration Template
# ==============================================================================
# Copy this file to .env and configure values for your environment.
# NEVER commit the actual .env file with real credentials to version control.

# Core Django Settings
DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_SECRET_KEY=change-this-to-a-secure-random-key-in-production-min-50-chars
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database Configuration (PostgreSQL 16)
DB_ENGINE=django.db.backends.postgresql
DB_NAME=genx_school_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# Redis & Celery Configuration (Redis 7)
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Security & Session Configuration (TBD-069)
SESSION_COOKIE_AGE=1800
SESSION_EXPIRE_AT_BROWSER_CLOSE=True
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False

# Biometric Hardware Integration (TBD-007, pyzk)
BIOMETRIC_DEVICE_IP=192.168.1.201
BIOMETRIC_DEVICE_PORT=4370
BIOMETRIC_DEVICE_TIMEOUT=5
BIOMETRIC_SYNC_INTERVAL_SECONDS=60

# WhatsApp Cloud API Integration (TBD-008, TBD-052)
WHATSAPP_API_URL=https://graph.facebook.com/v20.0
WHATSAPP_PHONE_NUMBER_ID=your-whatsapp-phone-number-id
WHATSAPP_BUSINESS_ACCOUNT_ID=your-whatsapp-business-account-id
WHATSAPP_ACCESS_TOKEN=your-whatsapp-system-user-access-token
WHATSAPP_WEBHOOK_VERIFY_TOKEN=your-webhook-verify-token
WHATSAPP_WEBHOOK_APP_SECRET=your-meta-app-secret

# Backup & Storage Configuration (TBD-073, TBD-074)
BACKUP_LOCAL_PATH=./backups/local/
BACKUP_GPG_RECIPIENT_KEY_ID=your-gpg-key-id
BACKUP_CLOUD_PROVIDER=s3
BACKUP_CLOUD_BUCKET=genx-school-offsite-backups
BACKUP_CLOUD_ENDPOINT_URL=https://s3.amazonaws.com
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_REGION=us-east-1

# Performance & Logging
LOG_LEVEL=INFO
REPORT_EXPORT_TIMEOUT_SECONDS=15
